# Copy to .env and adjust. Every value has a sensible default; nothing is required for local dev.

# development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# SQLite database file. Use ":memory:" for an ephemeral DB (tests/demos).
# In Docker this points at a mounted volume (see docker-compose.yml).
DATABASE_PATH=./data/expensesplit.db

# Optional shared secret. When set, every /api request must send it as
# "x-api-key: <value>" (or "Authorization: Bearer <value>"). Leave empty for open local demos.
API_KEY=

# Comma-separated list of allowed browser origins. "*" allows any origin.
# Not needed when the API serves the built client itself (same origin).
CORS_ORIGINS=*

# Default currency for new groups (ISO 4217)
DEFAULT_CURRENCY=USD

# pino log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Requests per minute per IP on /api before rate limiting kicks in
RATE_LIMIT_PER_MINUTE=300

# Allow POST /api/v1/demo/seed to (re)load demo data. Disable in real production.
ENABLE_DEMO_SEED=true

# Send Strict-Transport-Security / upgrade-insecure-requests headers.
# Turn on ONLY when the app is served over HTTPS (e.g. behind Render/Fly/Nginx TLS).
ENABLE_HSTS=false
